<div class="container">
    <h1>Ember Units Converters</h1>
    <section>
        <h2>Installation</h2>
        <b>With Yarn</b>
        <code>yarn add ember-units-converters</code>

        <b>With NPM</b>
        <code>npm install ember-units-converters</code>
    </section>
    <section>
        <h2>Usage</h2>
        <div>
            <h4>For distances</h4>
            <code>convert 10 "m" "dm"</code>
            <code class="result">{{convert value=10 from="m" to="dm"}}</code>
            <code>convert 10 "m" "dm"</code>
            <code class="result">{{convert value=10 from="m" to="km"}}</code>
            <code>convert 10 "hm" "dac"</code>
            <code class="result">{{convert value=10 from="hm" to="dam"}}</code>

            <code>convert 2 "mi" "km"</code>
            <code class="result">{{
                convert value=2 from="mi" to="km"
            }}</code>

            <code>convert 400 "ft" "yd"</code>
            <code class="result">{{
                convert value=400 from="ft" to="yd"
            }}</code>

            <h4>For volumes</h4>
            <code>convert 2 "l" "ml"</code>
            <code class="result">{{
                convert value=2 from="l" to="ml"
            }}</code>

            <code>convert 2 "UK gal" "ml"</code>
            <code class="result">{{
                convert value=2 from="UK gal" to="ml"
            }}</code>

            <code>convert 2 "US gal" "UK gal"</code>
            <code class="result">{{
                convert value=2 from="US gal" to="UK gal"
            }}</code>

            <h4>For Weight</h4>
            <code>convert 2 "kg" "g"</code>
            <code class="result">{{
                convert value=2 from="kg" to="g"
            }}</code>

            <code>convert 5 "lb" "oz"</code>
            <code class="result">{{
                convert value=5 from="lb" to="oz"
            }}</code>

            <h4>For temperatures</h4>
            <code>convert 23 'C' "K"</code>
            <code class="result">{{
                convert value=23 from="C" to="K"
            }}</code>

            <code>convert 23 'C' "F"</code>
            <code class="result">{{
                convert value=23 from="C" to="F"
            }}</code>

            <h4>For time</h4>
            <code>convert 60 's' "min"</code>
            <code class="result">{{
                convert value=60 from="s" to="min"
            }}</code>

            <h4>Display result without unit</h4>
            <code>convert 60 's' "min" false</code>
            <code class="result">{{
                convert value=60 from="s" to="min" withUnit=false
            }}</code>

            <h4>Display a fixed amount of digit</h4>
            <code>convert 134.678 'm' "km" true 2</code>
            <code class="result">{{
                convert value=134.678 from="m" to="km" digits=2
            }}</code>

        </div>
    </section>
</div>
